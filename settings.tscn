[gd_scene load_steps=2 format=3]

[ext_resource type="Script" path="res://settings.gd" id="1_settings"]

[node name="Settings" type="Control"]
layout_mode = 3
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
script = ExtResource("1_settings")

[node name="Title" type="Label" parent="."]
layout_mode = 0
offset_left = 400.0
offset_top = 220.0
offset_right = 880.0
offset_bottom = 270.0
theme_override_font_sizes/font_size = 30
text = "Настройки пока не реализованы"
horizontal_alignment = 1

[node name="BackButton" type="Button" parent="."]
layout_mode = 0
offset_left = 20.0
offset_top = 18.0
offset_right = 80.0
offset_bottom = 68.0
theme_override_font_sizes/font_size = 30
text = "←"
tooltip_text = "Вернуться в бой"

[connection signal="pressed" from="BackButton" to="." method="_on_back_pressed"]
