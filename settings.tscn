[gd_scene load_steps=5 format=3]

[ext_resource type="Script" path="res://settings.gd" id="1_settings"]
[ext_resource type="Texture2D" path="res://textures/MainMenu/Toggle_On.png" id="2_toggle_on"]
[ext_resource type="Texture2D" path="res://textures/MainMenu/Toggle_Off.png" id="3_toggle_off"]

[sub_resource type="StyleBoxFlat" id="StyleBoxFlat_panel"]
content_margin_left = 32.0
content_margin_top = 28.0
content_margin_right = 32.0
content_margin_bottom = 28.0
bg_color = Color(0.045, 0.06, 0.10, 0.88)
border_width_left = 2
border_width_top = 2
border_width_right = 2
border_width_bottom = 2
border_color = Color(0.28, 0.40, 0.54, 1)

[node name="SettingsOverlay" type="Control"]
process_mode = 3
layout_mode = 3
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
script = ExtResource("1_settings")

[node name="Center" type="CenterContainer" parent="."]
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2

[node name="Panel" type="PanelContainer" parent="Center"]
layout_mode = 2
theme_override_styles/panel = SubResource("StyleBoxFlat_panel")

[node name="Content" type="VBoxContainer" parent="Center/Panel"]
custom_minimum_size = Vector2(390, 0)
layout_mode = 2
theme_override_constants/separation = 18

[node name="Title" type="Label" parent="Center/Panel/Content"]
layout_mode = 2
theme_override_font_sizes/font_size = 30
text = "Настройки"
horizontal_alignment = 1

[node name="Volume" type="VBoxContainer" parent="Center/Panel/Content"]
layout_mode = 2
theme_override_constants/separation = 10

[node name="VolumeHeader" type="HBoxContainer" parent="Center/Panel/Content/Volume"]
layout_mode = 2

[node name="VolumeLabel" type="Label" parent="Center/Panel/Content/Volume/VolumeHeader"]
layout_mode = 2
size_flags_horizontal = 3
text = "Громкость звука"

[node name="VolumeValue" type="Label" parent="Center/Panel/Content/Volume/VolumeHeader"]
unique_name_in_owner = true
layout_mode = 2
text = "100%"
horizontal_alignment = 2

[node name="VolumeSlider" type="HSlider" parent="Center/Panel/Content/Volume"]
unique_name_in_owner = true
custom_minimum_size = Vector2(0, 40)
layout_mode = 2
step = 1.0
value = 100.0

[node name="VibrationToggle" type="CheckButton" parent="Center/Panel/Content"]
unique_name_in_owner = true
custom_minimum_size = Vector2(0, 48)
layout_mode = 2
theme_override_icons/checked = ExtResource("2_toggle_on")
theme_override_icons/unchecked = ExtResource("3_toggle_off")
button_pressed = true
text = "Вибрация"

[node name="JokeToggle" type="CheckButton" parent="Center/Panel/Content"]
unique_name_in_owner = true
custom_minimum_size = Vector2(0, 48)
layout_mode = 2
theme_override_icons/checked = ExtResource("2_toggle_on")
theme_override_icons/unchecked = ExtResource("3_toggle_off")
text = "Лох ли ты?  Нет"

[node name="BackButton" type="Button" parent="Center/Panel/Content"]
custom_minimum_size = Vector2(0, 50)
layout_mode = 2
text = "Назад"

[connection signal="value_changed" from="Center/Panel/Content/Volume/VolumeSlider" to="." method="_on_volume_changed"]
[connection signal="toggled" from="Center/Panel/Content/VibrationToggle" to="." method="_on_vibration_toggled"]
[connection signal="toggled" from="Center/Panel/Content/JokeToggle" to="." method="_on_joke_toggled"]
[connection signal="pressed" from="Center/Panel/Content/BackButton" to="." method="_on_back_pressed"]
