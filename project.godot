; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="StudenTravel"
run/main_scene="uid://bgyowlku82lf6"
config/features=PackedStringArray("4.7", "Mobile")
config/icon="res://textures/studentravel_icon.png"

[autoload]

GlobalGameManager="*uid://hb565xs01kxe"
GameState="*uid://d25qcagjr37sa"
Inventory="*res://inventory.gd"
GameSettings="*res://game_settings.gd"

[display]

window/size/window_width_override=1152
window/size/window_height_override=648
window/stretch/mode="canvas_items"
window/main_scene=""

[gui]

theme/custom="res://pixel_theme.tres"

[input_devices]

pointing/emulate_touch_from_mouse=true

[physics]

3d/physics_engine="Jolt Physics"

[rendering]

rendering_device/driver.windows="d3d12"
renderer/rendering_method="gl_compatibility"
textures/vram_compression/import_etc2_astc=true
